<?xml version="1.0" encoding="utf-8"?>
<!--
  NewTube adaptive-icon background (stmobile flavor).

  Full-bleed 108x108 layer; the launcher applies its own mask (circle / rounded
  square / squircle) on top. Flat #0F0F0F - the exact colour of the app icon's
  source art (mon_icone4.png) - so the bitmap foreground, which is an opaque
  square, blends into this layer with no seam and the mask crops only the black
  surround of the play badge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0F0F0F"
        android:pathData="M0,0h108v108h-108z" />
</vector>
