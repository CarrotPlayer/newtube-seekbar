    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1E1E1E" />
            <stroke android:width="1dp" android:color="#333EA6FF" />
        </shape>
    </item>
</selector>
