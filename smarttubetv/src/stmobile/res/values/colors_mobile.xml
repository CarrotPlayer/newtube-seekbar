         Material pink (#FF4081) inherited from the theme's colorAccent, which leaked into
         every checkbox, radio, caret and untinted spinner - see Theme.NewTube. -->
    <color name="mobile_color_cast_active">#4FC3F7</color>
    <color name="mobile_color_background">#0F0F0F</color>
    <color name="mobile_color_surface">#1E1E1E</color>
    <color name="mobile_color_on_surface">#FFFFFF</color>
    <color name="mobile_color_on_surface_secondary">#B3FFFFFF</color>
    <color name="mobile_color_badge_bg">#CC000000</color>
    <color name="mobile_color_badge_live_bg">#CCD32F2F</color>
    <color name="mobile_color_progress_track">#33FFFFFF</color>
    <color name="mobile_color_progress">#FF0000</color>
    <color name="mobile_color_placeholder">#2A2A2A</color>
    <color name="mobile_color_link">#4FC3F7</color>
    <color name="mobile_color_qr_bg">#FFFFFF</color>
    <color name="mobile_color_divider">#22FFFFFF</color>
    <color name="mobile_color_pill">#26FFFFFF</color>
    <!-- Opaque equivalent of the translucent pill over #0F0F0F. MaterialButton flattens a
         translucent background tint onto its white base, which made white "Subscribed" text
         disappear into a white button on-device. -->
    <color name="mobile_color_subscribed_button">#333333</color>
    <!-- NEWTUBE(comments-panel): the comment a replies page is about, set apart from its replies. -->
    <color name="mobile_color_comment_parent">#1A1A1A</color>
    <!-- The creator's handle on their own comments, and the panel's Top / Newest menu. -->
    <color name="mobile_color_comment_creator_pill">#24FFFFFF</color>
    <color name="mobile_color_menu_surface">#2A2A2A</color>
    <!-- A commenter's handle: brighter than the time beside it, quieter than the comment. -->
    <color name="mobile_color_comment_handle">#D1FFFFFF</color>
