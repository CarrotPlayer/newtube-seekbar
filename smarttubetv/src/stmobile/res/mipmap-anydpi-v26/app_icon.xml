<?xml version="1.0" encoding="utf-8"?>
<!-- NewTube adaptive launcher icon (API 26+), overrides @mipmap/app_icon for stmobile.

     Foreground: the app's own artwork, exactly as delivered (mon_icone4.png), only resized per
     density into mipmap-<density>/ic_launcher_foreground.png - the full 108dp square, so the
     play badge sits at ~48% of the canvas, inside the adaptive safe zone. Android applies the
     launcher's mask (circle / squircle / rounded square) on top.

     Background: the flat #0F0F0F of that artwork (drawable/ic_launcher_background), so the
     bitmap's edges - it is an opaque square - meet the background with no seam. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
