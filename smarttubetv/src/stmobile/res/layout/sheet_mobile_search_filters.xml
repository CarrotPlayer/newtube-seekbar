<?xml version="1.0" encoding="utf-8"?>
<!--
  NEWTUBE(search-filters): YouTube's "Search filter" sheet, opened from the search toolbar.

  Same window as the Download drawer (a Material bottom sheet with the app's sheet surface, the
  drag handle and a flat title row), then one section per filter category. The pill rows
  themselves are built in code (SearchFilterSheet): each category is ONE horizontally scrolling
  line, never wrapped onto two.

  The scrollers carry the 20dp side padding THEMSELVES with clipToPadding=false, so at rest the
  first pill lines up with the title while a scrolled row keeps drawing into that padding - a pill
  is only ever cut by the screen's own edge, never by the sheet's margin.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mobile_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/mobile_search_filter_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mobile_search_filter_title"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Reset: plain text, NO ripple (a touch here must not flash the sheet) - it clears the
             filters and leaves the sheet open. -->
        <TextView
            android:id="@+id/mobile_search_filter_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:text="@string/mobile_search_filter_reset"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mobile_search_filter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
