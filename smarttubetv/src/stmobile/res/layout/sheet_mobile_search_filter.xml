<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <!-- Poignée de glissement (Drag handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_mobile_drag_handle" />

    <!-- En-tête : Titre + Reset -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Search filters"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filter_btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="Reset"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- SECTION 1 : Sort by -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:text="Sort by"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_sort_relevance"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Relevance"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_sort_popularity"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Popularity"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- SECTION 2 : Upload date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:text="Upload date"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_date_today"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Today"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_date_week"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="This week"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_date_month"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="This month"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_date_year"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="This year"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- SECTION 3 : Duration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:text="Duration"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_duration_under4"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Under 4 mins"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_duration_4to20"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="4–20 mins"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_duration_over20"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Over 20 mins"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- SECTION 4 : Type -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:text="Type"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_type_videos"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Videos"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_type_channels"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Channels"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_type_playlists"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Playlists"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_type_movies"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Movies"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- SECTION 5 : Features -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        android:text="Features"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_feat_live"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Live"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_feat_4k"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="4K"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pill_feat_hdr"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_filter_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="HDR"
                android:textColor="@color/color_filter_pill_text"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
