<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <!-- En-tête : Titre à gauche + Bouton Icône Reset à droite -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtres de recherche"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/filter_btn_reset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Réinitialiser"
            android:padding="10dp"
            android:src="@drawable/ic_mobile_reset"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Ligne 1 : Type -->
    <LinearLayout
        android:id="@+id/filter_row_type"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Type"
            android:textColor="#B3B3B3"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/filter_val_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toutes les catégories"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mobile_chevron_down"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Ligne 2 : Durée -->
    <LinearLayout
        android:id="@+id/filter_row_duration"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Durée"
            android:textColor="#B3B3B3"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/filter_val_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toutes"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mobile_chevron_down"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Ligne 3 : Date d'ajout -->
    <LinearLayout
        android:id="@+id/filter_row_date"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Date d'ajout"
            android:textColor="#B3B3B3"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/filter_val_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date indifférente"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mobile_chevron_down"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Ligne 4 : Priorité -->
    <LinearLayout
        android:id="@+id/filter_row_sort"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Priorité"
            android:textColor="#B3B3B3"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/filter_val_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pertinence"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_mobile_chevron_down"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Section Caractéristiques -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caractéristiques"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Badges / Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_feature_live"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp"
            android:text="En direct"
            android:textColor="#3EA6FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chip_feature_4k"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="8dp"
            android:text="4K"
            android:textColor="#3EA6FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chip_feature_hdr"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="HDR"
            android:textColor="#3EA6FF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bouton Appliquer -->
    <TextView
        android:id="@+id/filter_btn_apply"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_filter_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Appliquer"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
