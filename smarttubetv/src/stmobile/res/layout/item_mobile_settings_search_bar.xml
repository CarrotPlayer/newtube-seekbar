<?xml version="1.0" encoding="utf-8"?>
<!-- "Search settings" at the top of Settings, like Android's own. A tap grows it into the search
     page (MaterialContainerTransform; the pill is the shared element). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/settings_search_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/mobile_settings_search_bar"
        android:clickable="true"
        android:contentDescription="@string/mobile_settings_search_hint"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mobile_search"
            android:tint="@color/mobile_color_on_surface_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/mobile_settings_search_hint"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
